
name: Build APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'VoiceHelper.zip'
      - '.github/workflows/**'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Extract VoiceHelper project
        run: |
          unzip -o VoiceHelper.zip -d extracted
          echo "PROJECT_DIR=$(find extracted -type f \( -name gradlew -o -name build.gradle -o -name build.gradle.kts \) -print -quit | xargs dirname)" >> "$GITHUB_ENV"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: gradle -p "$PROJECT_DIR" assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: VoiceHelper-apk
          path: extracted/**/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
